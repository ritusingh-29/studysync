# Paste your full MongoDB Atlas connection string here:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.your_cluster.mongodb.net/?retryWrites=true&w=majority

# Or separate credentials:
# DB_USER=your_db_username
# DB_PASS=your_db_password
# DB_CLUSTER=cluster0.your_cluster.mongodb.net

# Random secret string for JWT authentication tokens:
ACCESS_TOKEN_SECRET=your_jwt_random_secret_key_here
PORT=5000
